# Release automation for the WANGJIA app.
#   bundle install                      (once; see Gemfile)
#   bundle exec fastlane ios beta       -> TestFlight
#   bundle exec fastlane ios release    -> App Store review
#   bundle exec fastlane android beta   -> Play internal testing
#   bundle exec fastlane android release-> Play production
#
# Build-time config is passed with DART_DEFINES, e.g.
#   DART_DEFINES="MEDUSA_URL=https://api.wangjia.co.id,MEDUSA_PUBLISHABLE_KEY=pk_live_xxx,SENTRY_DSN=https://...,APP_ENV=production"
# Secrets (App Store Connect API key, Play service account JSON) come from
# environment variables, never from the repo. See apps/mobile/README.md.

default_platform(:ios)

def dart_define_args
  defines = (ENV["DART_DEFINES"] || "").split(",").map(&:strip).reject(&:empty?)
  defines.map { |d| "--dart-define=#{d}" }.join(" ")
end

def build_number
  ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
end

platform :ios do
  before_all do
    # App Store Connect API key (Users and Access -> Integrations -> App Store Connect API)
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"), # base64 of the .p8
      is_key_content_base64: true
    )
  end

  desc "Build the iOS release archive"
  lane :build do
    sh("cd .. && flutter build ipa --release --build-number=#{build_number} #{dart_define_args}")
  end

  desc "Upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      ipa: "../build/ios/ipa/wangjia_app.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Perbaikan dan peningkatan."
    )
  end

  desc "Submit to App Store review"
  lane :release do
    build
    upload_to_app_store(
      ipa: "../build/ios/ipa/wangjia_app.ipa",
      submit_for_review: true,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :android do
  desc "Build the Android app bundle"
  lane :build do
    sh("cd .. && flutter build appbundle --release --build-number=#{build_number} #{dart_define_args}")
  end

  desc "Upload to Play internal testing"
  lane :beta do
    build
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote to production"
  lane :release do
    build
    upload_to_play_store(
      track: "production",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
  end
end
