STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-v2
# Midtrans (https://dashboard.midtrans.com -> Settings -> Access Keys)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Where Midtrans Snap redirects the customer after paying (app deep link or web page)
MIDTRANS_FINISH_URL=http://localhost:8000/id/account/orders
# Role given to admin users whose metadata has no "role": none (no access to finance/warehouse actions) | owner | sales | finance | warehouse.
# Bootstrap: while NO admin user has a role yet, everyone is treated as owner so the first admin can assign roles in 团队角色.
ADMIN_DEFAULT_ROLE=none

# Unpaid payment plans: cancel after N days without deposit (or past first due_date); hourly cron
PAYMENT_PLAN_EXPIRE_DAYS=7
PAYMENT_PLAN_EXPIRE_CRON=0 * * * *

# ---- Production infrastructure ----
# Redis (event bus, workflow engine, cache, locking). Leave empty in local dev.
# REDIS_URL=redis://localhost:6379
# S3-compatible storage for uploads (Cloudflare R2 / AWS S3 / MinIO). Leave empty to use local ./static.
# S3_FILE_URL=https://<account>.r2.cloudflarestorage.com/<bucket>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_BUCKET=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PREFIX=
# S3_SIGNED_URL_SECONDS=900

# ---- Notifications ----
# WhatsApp Business Cloud API (developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved utility template that wraps every system message ({{1}}); see docs/whatsapp-templates.md.
# Without it messages go as free text, which Meta only delivers within 24h of the customer's last message.
WHATSAPP_TEMPLATE_NAME=wangjia_notice
WHATSAPP_TEMPLATE_LANG=id
# Email via Resend (resend.com). Staff emails fall back to users with the finance/warehouse role.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=WANGJIA Indonesia <no-reply@example.com>
FINANCE_NOTIFY_EMAILS=
WAREHOUSE_NOTIFY_EMAILS=
# Base URL of the admin, used in staff notification links
ADMIN_URL=http://localhost:9000/app

# Phone verification at sign-up (WhatsApp OTP). OTP_DEV_CODE is accepted outside production.
OTP_REQUIRED=false
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=5
OTP_DEV_CODE=000000
# Storefront base URL used in password-reset emails
STOREFRONT_URL=http://localhost:8000

# Push notifications (Firebase Cloud Messaging). Path to the service-account JSON, or the JSON / base64 itself.
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Invoice header (shown on PDF invoices)
COMPANY_NAME=PT Adhinusa Lestari Jaya
COMPANY_BRAND=WANGJIA® Kincir Air
COMPANY_ADDRESS=Jakarta, Indonesia
COMPANY_NPWP=00.000.000.0-000.000
COMPANY_PHONE=+62 812 0000 0000
COMPANY_EMAIL=sales@example.com
COMPANY_BANK=BCA 1234567890 a.n. PT Adhinusa Lestari Jaya
# Public URL of this backend, used in signed invoice links
BACKEND_PUBLIC_URL=http://localhost:9000

# Set to true only in tests; public endpoints are rate limited per IP otherwise
RATE_LIMIT_DISABLED=false

# Payment reminders: days before due date to remind; cron in UTC (02:00 UTC = 09:00 WIB)
REMINDER_DAYS_BEFORE=2
REMINDER_CRON=0 2 * * *

# Error reporting: DSN of the "backend" project in GlitchTip (deploy/docker-compose.glitchtip.yml). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Shipment tracking via Biteship (biteship.com, free tracking API). Empty = show numbers only.
# Warehouse enters labels as "<courier>:<waybill>", e.g. jne:JP0123456789, sicepat:000123456789, lion:1234567890
BITESHIP_API_KEY=

# Warranty expiry reminders: days before expiry; cron in UTC (02:30 UTC = 09:30 WIB)
WARRANTY_REMINDER_DAYS=30
WARRANTY_REMINDER_CRON=30 2 * * *

# Daily Chinese summary for the owner (orders, money in, overdue, quotes, warranties). Empty = off.
OWNER_WHATSAPP=
OWNER_EMAILS=
OWNER_DIGEST_CRON=30 0 * * *

# Small orders (spare parts) get a single "full payment" plan automatically so the customer
# can pay at once. Max order total in IDR (0 = off); due in AUTO_PLAN_DUE_DAYS days.
AUTO_PLAN_MAX_TOTAL=15000000
AUTO_PLAN_DUE_DAYS=3

# Mobile app version policy (semver). Below MIN the app blocks until updated; below LATEST it shows a banner.
APP_MIN_VERSION=0.1.0
APP_LATEST_VERSION=0.1.0
APP_ANDROID_URL=https://play.google.com/store/apps/details?id=id.co.wangjia.wangjia_app
APP_IOS_URL=https://apps.apple.com/app/id0000000000
APP_UPDATE_MESSAGE=

# DocuSeal e-signature webhook (deploy/docker-compose.docuseal.yml). Empty = webhook disabled.
DOCUSEAL_WEBHOOK_SECRET=

# Post-delivery check-in: days after delivery to ask whether the machine runs well; cron in UTC (03:00 UTC = 10:00 WIB)
FOLLOWUP_DAYS=7
FOLLOWUP_CRON=0 3 * * *
